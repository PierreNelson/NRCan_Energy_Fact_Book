# NRCan Energy Factbook - Database Configuration
# Copy this file to .env and fill in your SQL Server credentials
#
# The .env file is gitignored and will not be committed to the repository.

DB_SERVER=localhost
DB_DATABASE=NRCanEnergyFactbook
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Optional: Specify ODBC driver (leave empty for auto-detection)
# DB_DRIVER=ODBC Driver 18 for SQL Server

# ---------------------------------------------------------------------------
# SharePoint Manual Data (BenchScope) — pipeline Excel workbooks
# ---------------------------------------------------------------------------
# eedas update syncs from SharePoint before reading Excel. Files are cached
# locally in EXTERNAL_XLSX_DATA_DIR (not committed to git).

SHAREPOINT_HOSTNAME=hustlebench.sharepoint.com
SHAREPOINT_SITE_PATH=sites/BenchScope
SHAREPOINT_FOLDER_PATH=Manual Data
EXTERNAL_XLSX_DATA_DIR=../data/sharepoint_cache

# Headless auth — Azure AD app registration (client credentials).
# User password auth cannot bypass MFA; register an app once with:
#   1. Azure Portal → App registrations → New registration
#   2. API permissions → Microsoft Graph → Application → Sites.Read.All
#   3. Grant admin consent
#   4. Certificates & secrets → New client secret
AZURE_TENANT_ID=your-tenant-guid
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-client-secret
