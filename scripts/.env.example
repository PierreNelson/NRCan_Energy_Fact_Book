# NRCan Energy Factbook - Database Configuration
# Copy this file to .env and fill in your SQL Server credentials
#
# The .env file is gitignored and will not be committed to the repository.

DB_SERVER=localhost
DB_DATABASE=NRCanEnergyFactbook
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Optional: Specify ODBC driver (leave empty for auto-detection)
# DB_DRIVER=ODBC Driver 18 for SQL Server

# Folder containing local Excel workbooks (CEA, IEA World Energy Balances, ECCC GHG Annex,
# EE Improvement, Primary Energy Use Demand, SEU Final Demand, TSX listing export, etc.).
# If unset, the pipeline looks for those files at the repository root.
# EXTERNAL_XLSX_DATA_DIR=C:\Users\Piers\NRCan_Energy_Factbook_data
